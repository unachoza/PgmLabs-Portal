# Browser (Vite) — safe to expose, anon key is RLS-protected
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Set to "mock" to run the UI without Supabase during local dev.
VITE_AUTH_MODE=real

# Server (Vercel functions) — NEVER expose to the browser.
# The service-role key bypasses RLS; API endpoints authorize manually.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Accounting integration — Phase 0 (manual ingestion) needs none of the below.
# Phase 1 (live OAuth pull) adds, server-only:
#   ACCOUNTING_TOKEN_ENC_KEY=   # AES-256 key encrypting stored provider tokens
#   QBO_CLIENT_ID=              # Intuit QuickBooks OAuth app
#   QBO_CLIENT_SECRET=
#   XERO_CLIENT_ID=             # Xero OAuth app
#   XERO_CLIENT_SECRET=
#   TRIPLETEX_CONSUMER_TOKEN=   # Tripletex API session auth
#   TRIPLETEX_EMPLOYEE_TOKEN=
# HubSpot private app access token. Grant read scopes for contacts, companies,
# deals, and tickets in the HubSpot private app settings.
HUBSPOT_TOKEN=your-hubspot-private-app-token
