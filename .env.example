# Browser (Vite) — safe to expose, anon key is RLS-protected
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server (Vercel functions) — NEVER expose to the browser.
# The service-role key bypasses RLS; API endpoints authorize manually.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HubSpot private app access token. Grant read scopes for contacts, companies,
# deals, and tickets in the HubSpot private app settings.
HUBSPOT_TOKEN=your-hubspot-private-app-token
